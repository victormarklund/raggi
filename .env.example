# Copy to `.env` and adjust. Docker Compose reads `.env` automatically.

# --- Production (docker-compose.yml) -----------------------------------------
# Host interface to bind. Use 127.0.0.1 when a reverse proxy on the same machine
# terminates TLS, or 0.0.0.0 to expose the app on the network.
RAGGI_BIND=0.0.0.0
# Host port that serves the app (nginx listens on 80 inside the container).
RAGGI_PORT=8080

# --- Development (docker-compose.dev.yml) ------------------------------------
RAGGI_DEV_BIND=0.0.0.0
# Host port for the Vite dev server.
RAGGI_DEV_PORT=5173
# Extra hostnames the dev server should accept, comma separated
# (needed when testing through a tunnel, e.g. "raggi.example.trycloudflare.com").
# Use "true" to allow any host.
RAGGI_DEV_ALLOWED_HOSTS=
# Poll for file changes (reliable HMR with bind mounts on macOS/Windows).
CHOKIDAR_USEPOLLING=true
